# Copy to .env and fill in. Never commit .env.

# Needed only for the agent (Milestone 3). Imagery access needs no credentials.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Imagery source (defaults shown)
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a

# Where AOI crops and reports are written
ASK_SAT_CACHE_DIR=data/cache
ASK_SAT_OUTPUT_DIR=outputs
